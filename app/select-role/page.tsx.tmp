'use client'

import { useEffect, useMemo, useState } from 'react'
import { useRouter } from 'next/navigation'
import {
  Palette,
  Building2,
  KeyRound,
  Brush,
  Sparkles,
  Crown,
  Check,
  CheckCircle2,
  Loader2,
} from 'lucide-react'
import api from '@/lib/api'
import { useAuthStore } from '@/lib/store'
import { getDashboardRouteFromUser } from '@/lib/role-utils'
import {
  CapabilitySummary,
  RoleOverview,
  SubscriptionPlanCode,
  UserRoleCode,
} from '@/types/capabilities'

type BackendRoleResponse = {
  message: string
  user: any
  capabilities: CapabilitySummary
}

type RoleCard = {
  id: UserRoleCode
  emoji: string
  label: string
  description: string
  proHighlight: string
}

type PlanCard = {
  code: SubscriptionPlanCode
  label: string
  headline: string
  bulletPoints: string[]
  badge: string
}

const FALLBACK_ROLES: RoleCard[] = [
  {
    id: 'art_lover',
    emoji: '🎨',
    label: 'Sanat Sever',
    description: 'Sanat dünyasını keşfet, beğen ve ilham al.',
    proHighlight: 'Pro ile sınırsız etkileşim ve derin analiz erişimi.',
  },
  {
    id: 'corporate',
    emoji: '🏢',
    label: 'Kurumsal',
    description: 'Kurumunu görünür kıl, etkinlik düzenle, ziyaretçi verilerini analiz et.',
    proHighlight: 'Pro ile sınırsız etkinlik oluşturma ve özel raporlama.',
  },
  {
    id: 'collector',
    emoji: '🗝️',
    label: 'Koleksiyoner',
    description: 'Koleksiyonunu dijital olarak yönet, sergile ve etkileşime aç.',
    proHighlight: 'Pro ile sınırsız koleksiyon ve ziyaretçi analitiği.',
  },
  {
    id: 'artist',
    emoji: '🖌️',
    label: 'Sanatçı',
    description: 'Eserlerini paylaş, kitlene ulaş, ilan aç.',
    proHighlight: 'Pro ile sınırsız sergi, ilan ve bilet yönetimi.',
  },
]

const FALLBACK_PLANS: PlanCard[] = [
  {
    code: 'FREE',
    label: 'Standart Üyelik',
    headline: 'Sanatla dijital dünyada tanışmak için mükemmel başlangıç.',
    bulletPoints: ['🎟️ Ayda 1 etkinlik oluşturma', '📊 Temel analizler', '💬 Topluluk etkileşimi'],
    badge: 'Standart',
  },
  {
    code: 'PRO',
    label: 'Profesyonel Üyelik',
    headline: 'Yaratıcılığını genişlet, profesyonel araçlara eriş.',
    bulletPoints: [
      '🚀 Sınırsız etkinlik ve koleksiyon yönetimi',
      '🧠 İleri düzey analiz paneli',
      '🟤 Feellink Pro Rozeti (profilde görünür)',
    ],
    badge: 'Pro',
  },
]

const ROLE_ICON_MAP: Record<UserRoleCode, React.ElementType> = {
  art_lover: Palette,
  corporate: Building2,
  collector: KeyRound,
  artist: Brush,
}

const ROLE_BADGE_MAP: Record<UserRoleCode, string> = {
  art_lover: '🟤',
  corporate: '🟧',
  collector: '🟤',
  artist: '🟤',
}

export default function SelectRolePage() {
  const router = useRouter()
  const { user, capabilities, accessToken, setUser, setCapabilities } = useAuthStore()

  const [overview, setOverview] = useState<RoleOverview | null>(null)
  const [selectedRoles, setSelectedRoles] = useState<UserRoleCode[]>(capabilities?.roles ?? [])
  const [selectedPlan, setSelectedPlan] = useState<SubscriptionPlanCode>(capabilities?.plan ?? 'FREE')
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [showSuccess, setShowSuccess] = useState(false)

  useEffect(() => {
    if (!accessToken) {
      router.replace('/login')
      return
    }

    const fetchOverview = async () => {
      try {
        const response = await api.get('/users/roles/overview')
        const data = response.data as RoleOverview
        setOverview(data)
        if (!capabilities || capabilities.roles.length === 0) {
          setSelectedRoles(['art_lover'])
        }
      } catch (err) {
        setOverview({
          roles: FALLBACK_ROLES,
          plans: FALLBACK_PLANS,
          features: FALLBACK_ROLES.reduce((acc, role) => {
            acc[role.id] = {
              canCreateEvents: role.id === 'corporate',
              canAccessMyEvents: role.id !== 'art_lover',
              canAccessCollections: role.id === 'collector',
              canManageCollections: role.id === 'collector',
              canAccessAnalytics: role.id !== 'art_lover',
              canCreateListings: role.id === 'artist' || role.id === 'corporate',
            }
            return acc
          }, {} as RoleOverview['features']),
          limits: FALLBACK_ROLES.reduce((acc, role) => {
            acc[role.id] = {
              eventsPerMonth:
                role.id === 'corporate'
                  ? { free: 1, pro: null }
                  : role.id === 'collector' || role.id === 'artist'
                    ? { free: 1, pro: null }
                    : { free: 0, pro: 0 },
            }
            return acc
          }, {} as RoleOverview['limits']),
          combinations: [
            {
              id: 'corporate_collector',
              roles: ['corporate', 'collector'],
              summary: 'Kurumsal + Koleksiyoner',
              features: ['Etkinlik yönetimi', 'Koleksiyon vitrini', 'İleri düzey ziyaretçi analizi'],
            },
            {
              id: 'artlover_artist',
              roles: ['art_lover', 'artist'],
              summary: 'Sanat Sever + Sanatçı',
              features: ['Takipçi topluluğu', 'İlan açma', 'Portföy sergileme'],
            },
            {
              id: 'all',
              roles: ['art_lover', 'corporate', 'collector', 'artist'],
              summary: 'Feellink Premium',
              features: ['Tüm özel modüller', 'Premium arayüz', 'Gerçek zamanlı raporlar'],
            },
          ],
        })
        setError('Roller yüklenirken bir sorun oluştu, varsayılan içerik gösteriliyor.')
      } finally {
        setLoading(false)
      }
    }

    fetchOverview()
  }, [accessToken, router, capabilities])

  useEffect(() => {
    if (capabilities) {
      setSelectedRoles(capabilities.roles)
      setSelectedPlan(capabilities.plan)
    }
  }, [capabilities])

  const handleToggleRole = (role: UserRoleCode) => {
    setSelectedRoles((prev) =>
      prev.includes(role) ? prev.filter((r) => r !== role) : [...prev, role]
    )
    setError(null)
  }

  const activeCombinations = useMemo(() => {
    if (!overview) return []
    const roleSet = new Set(selectedRoles)
    return overview.combinations.filter((combo) => combo.roles.every((r) => roleSet.has(r)))
  }, [overview, selectedRoles])

  const eventLimitDescription = useMemo(() => {
    if (!overview) return ''
    const limits = selectedRoles.map((role) => {
      const config = overview.limits[role]?.eventsPerMonth
      if (!config) return 0
      return config[selectedPlan === 'PRO' ? 'pro' : 'free'] ?? Infinity
    })

    if (limits.includes(Infinity)) {
      return 'Sınırsız etkinlik oluşturma'
    }

    const maxLimit = Math.max(...limits, 0)
    return maxLimit === 0
      ? 'Etkinlik oluşturma desteği yok'
      : `Aylık ${maxLimit} etkinlik oluşturma`
  }, [overview, selectedRoles, selectedPlan])

  const handleSave = async () => {
    if (selectedRoles.length === 0) {
      setError('En az bir rol seçmelisiniz.')
      return
    }

    try {
      setSaving(true)
      setError(null)

      const rolesResponse = await api.patch<BackendRoleResponse>('/users/me/roles', {
        roles: selectedRoles,
      })

      let latestUser = rolesResponse.data.user
      let latestCapabilities = rolesResponse.data.capabilities

      if (selectedPlan !== (capabilities?.plan ?? 'FREE')) {
        const planResponse = await api.patch<BackendRoleResponse>('/users/me/plan', {
          plan: selectedPlan,
        })
        latestUser = planResponse.data.user
        latestCapabilities = planResponse.data.capabilities
      }

      setUser(latestUser, latestCapabilities)
      setCapabilities(latestCapabilities)

      const destination = getDashboardRouteFromUser({
        roles: latestCapabilities.roles,
        isAdmin: latestUser.isAdmin,
        capabilities: latestCapabilities,
      })

      setShowSuccess(true)
      setTimeout(() => {
        router.replace(destination)
      }, 900)
    } catch (err: any) {
      setError(err.response?.data?.message || 'Kaydederken bir sorun oluştu.')
      setSaving(false)
    }
  }

  if (loading || !overview) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#fdfdfd] via-[#fafafa] to-[#f5f5f5] dark:from-[#0e0e0e] dark:via-[#121212] dark:to-[#161616]">
        <div className="flex flex-col items-center gap-4 text-gray-500 dark:text-gray-400">
          <Loader2 className="h-8 w-8 animate-spin" />
          <p>Rol seçenekleri yükleniyor...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="relative min-h-screen bg-gradient-to-br from-[#fdfdfd] via-[#fafafa] to-[#f5f5f5] dark:from-[#0e0e0e] dark:via-[#121212] dark:to-[#161616]">
      {showSuccess && (
        <div className="absolute inset-0 z-50 flex flex-col items-center justify-center gap-4 bg-black/70 text-white backdrop-blur-sm transition-opacity duration-500">
          <Sparkles className="h-12 w-12 text-[#ff7b00] animate-pulse" />
          <div className="text-center">
            <p className="text-lg font-semibold">Kişiselleştiriliyor...</p>
            <p className="mt-1 text-sm text-white/80">Dashboard deneyimin hazırlanıyor.</p>
          </div>
        </div>
      )}

      <div className="relative z-10 max-w-6xl mx-auto px-6 py-14">
        <header className="mb-12">
          <div className="inline-flex items-center gap-2 rounded-full border border-orange-200/60 bg-orange-100/60 px-3 py-1 text-[13px] font-medium text-orange-600 dark:bg-orange-500/10 dark:border-orange-400/40 dark:text-orange-200">
            <Sparkles className="h-3.5 w-3.5" /> Feellink Role Experience
          </div>
          <h1 className="mt-6 text-4xl font-semibold tracking-tight text-gray-900 dark:text-white">
            Feellink Deneyimini Kişiselleştir
          </h1>
          <p className="mt-3 max-w-2xl text-base text-gray-600 dark:text-gray-400">
            Dijital sanat evreninde rolünü seç. Kombinasyonlarını özgürce oluştur, yaratıcılığını genişlet ve markanı görünür kıl.
          </p>
        </header>

        {error && (
          <div className="mb-8 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 shadow-sm dark:bg-red-900/10 dark:border-red-800/80 dark:text-red-200">
            {error}
          </div>
        )}

        <section className="mb-14">
          <div className="mb-6 flex items-center justify-between">
            <h2 className="text-lg font-semibold text-gray-900 dark:text-white">Üyelik Planı</h2>
            <span className="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Two tiers</span>
          </div>
          <div className="grid grid-cols-1 gap-6 md:grid-cols-2">
            {overview.plans.map((plan) => {
              const isActive = plan.code === selectedPlan
              return (
                <button
                  key={plan.code}
                  type="button"
                  onClick={() => setSelectedPlan(plan.code)}
                  className={`relative overflow-hidden rounded-2xl border px-6 py-7 text-left transition-all duration-300 ${
                    isActive
                      ? 'border-orange-400/70 bg-white shadow-xl shadow-orange-500/10 dark:border-orange-400/50 dark:bg-white/5'
                      : 'border-gray-200/80 bg-white/80 hover:border-orange-300/70 hover:shadow-lg hover:shadow-orange-500/10 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-orange-400/40'
                  }`}
                >
                  <span className={`absolute right-6 top-6 rounded-full px-2.5 py-0.5 text-xs font-semibold tracking-wide ${
                    plan.code === 'PRO'
                      ? 'bg-orange-500 text-white'
                      : 'bg-gray-900/10 text-gray-700 dark:bg-white/10 dark:text-white'
                  }`}
                  >
                    {plan.badge}
                  </span>
                  <h3 className="text-lg font-semibold text-gray-900 dark:text-white">{plan.label}</h3>
                  <p className="mt-2 text-sm text-gray-500 dark:text-gray-400">{plan.headline}</p>
                  <ul className="mt-5 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                    {plan.bulletPoints.map((point) => (
                      <li key={point} className="flex items-center gap-2">
                        <CheckCircle2 className={`h-4 w-4 ${plan.code === 'PRO' ? 'text-orange-500' : 'text-gray-300 dark:text-gray-500'}`} />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                  {plan.code === 'PRO' && (
                    <p className="mt-4 inline-flex items-center gap-1 rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-medium text-orange-600 shadow-sm dark:border-orange-400/40 dark:bg-orange-500/10 dark:text-orange-200" title="Feellink Pro üyelik, markanı ve eserlerini öne çıkarır.">
                      <Crown className="h-3.5 w-3.5" /> Feellink Pro ayrıcalığı
                    </p>
                  )}
                </button>
              )
            })}
          </div>
        </section>

        <section className="mb-14">
          <div className="mb-6 flex items-center justify-between">
            <h2 className="text-lg font-semibold text-gray-900 dark:text-white">Roller</h2>
            <span className="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Select combination</span>
          </div>
          <div className="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
            {overview.roles.map((role) => {
              const isActive = selectedRoles.includes(role.id)
              const Icon = ROLE_ICON_MAP[role.id] ?? Palette
              const features = overview.features[role.id]
              const limits = overview.limits[role.id].eventsPerMonth
              const badge = ROLE_BADGE_MAP[role.id] ?? '🟤'

              const limitText =
                selectedPlan === 'PRO'
                  ? limits.pro === null
                    ? 'Pro ile sınırsız etkinlik'
                    : `Pro: Aylık ${limits.pro}`
                  : limits.free === 0
                    ? 'Etkinlik oluşturma yok'
                    : `Free: Aylık ${limits.free}`

              return (
                <button
                  key={role.id}
                  type="button"
                  onClick={() => handleToggleRole(role.id)}
                  className={`relative rounded-2xl border px-6 py-7 text-left transition-all duration-300 ${
                    isActive
                      ? 'border-orange-400 bg-white shadow-xl shadow-orange-500/15 ring-2 ring-orange-400/40 dark:border-orange-300/60 dark:bg-white/5'
                      : 'border-gray-200/70 bg-white/80 hover:-translate-y-1 hover:border-orange-300/70 hover:shadow-lg hover:shadow-orange-500/10 dark:border-white/10 dark:bg-white/[0.04]'
                  }`}
                >
                  <span className="absolute right-4 top-4 text-lg" title="Pro üyelik ile özel rozet">
                    {badge}
                  </span>
                  <span className="absolute left-4 top-4 rounded-full bg-orange-100/80 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-orange-600 dark:bg-orange-500/15 dark:text-orange-200">
                    PRO
                  </span>
                  <div className="mt-6 flex items-center gap-3">
                    <div className={`flex h-12 w-12 items-center justify-center rounded-xl text-lg transition-colors ${
                      isActive
                        ? 'bg-orange-500 text-white'
                        : 'bg-gray-100 text-orange-500 dark:bg-white/5 dark:text-orange-300'
                    }`}>
                      <Icon className="h-6 w-6" />
                    </div>
                    <div>
                      <p className="text-base font-semibold text-gray-900 dark:text-white">{role.label}</p>
                      <p className="text-sm text-gray-500 dark:text-gray-400">{limitText}</p>
                    </div>
                  </div>
                  <p className="mt-5 text-sm text-gray-600 dark:text-gray-300">{role.description}</p>
                  <p className="mt-2 text-sm font-medium text-orange-500 dark:text-orange-300">{(role as RoleCard).proHighlight ?? ''}</p>
                  <ul className="mt-5 space-y-2 text-sm text-gray-600 dark:text-gray-300">
                    {features.canCreateEvents && <li className="flex items-center gap-2"><Check className="h-3.5 w-3.5 text-orange-500" /> Etkinlik oluşturma</li>}
                    {features.canAccessMyEvents && <li className="flex items-center gap-2"><Check className="h-3.5 w-3.5 text-orange-500" /> Etkinlik yönetimi</li>}
                    {features.canAccessCollections && <li className="flex items-center gap-2"><Check className="h-3.5 w-3.5 text-orange-500" /> Koleksiyonlara erişim</li>}
                    {features.canManageCollections && <li className="flex items-center gap-2"><Check className="h-3.5 w-3.5 text-orange-500" /> Koleksiyon yönetimi</li>}
                    {features.canCreateListings && <li className="flex items-center gap-2"><Check className="h-3.5 w-3.5 text-orange-500" /> İlan açma</li>}
                    {features.canAccessAnalytics && <li className="flex items-center gap-2"><Check className="h-3.5 w-3.5 text-orange-500" /> Analizler</li>}
                  </ul>
                </button>
              )
            })}
          </div>
        </section>

        <section className="mb-12">
          <div className="rounded-2xl border border-orange-200/70 bg-white/80 px-6 py-6 shadow-sm dark:border-orange-500/40 dark:bg-orange-500/10">
            <div className="mb-4 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <Sparkles className="h-5 w-5 text-orange-500" />
                <h3 className="text-sm font-semibold uppercase tracking-[0.3em] text-orange-500 dark:text-orange-200">
                  Aktif Kombinasyon Avantajları
                </h3>
              </div>
              <span className="text-xs text-orange-400">{activeCombinations.length || '0'} paket</span>
            </div>
            {activeCombinations.length === 0 ? (
              <p className="text-sm text-orange-700/80 dark:text-orange-100">
                Rol kombinasyonu seçtiğinizde özel avantajlar burada belirecek.
              </p>
            ) : (
              <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
                {activeCombinations.map((combo) => (
                  <div key={combo.id} className="relative overflow-hidden rounded-xl border border-orange-200 bg-orange-50/60 px-4 py-4 shadow-sm dark:border-orange-500/20 dark:bg-orange-500/15">
                    <div className="absolute -right-6 -top-6 h-16 w-16 rounded-full bg-orange-500/10 blur-xl" />
                    <p className="text-sm font-semibold text-orange-600 dark:text-orange-100">{combo.summary}</p>
                    <ul className="mt-2 space-y-1 text-sm text-orange-700/90 dark:text-orange-200/80">
                      {combo.features.map((feature) => (
                        <li key={feature}>• {feature}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>

        <footer className="flex flex-col gap-6 border-t border-gray-200 pt-8 dark:border-white/10 md:flex-row md:items-center md:justify-between">
          <div className="text-sm text-gray-600 dark:text-gray-400">
            <p className="font-medium text-gray-900 dark:text-white">Rol seçimi özeti</p>
            <p>Seçilen roller: <span className="font-semibold text-orange-500">{selectedRoles.length}</span></p>
            <p>Etkinlik kapasitesi: <span className="font-medium text-gray-800 dark:text-gray-200">{eventLimitDescription}</span></p>
          </div>
          <button
            onClick={handleSave}
            disabled={saving}
            className="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-3 text-white font-semibold shadow-lg shadow-orange-500/30 transition hover:from-orange-500/90 hover:to-orange-600/90 disabled:opacity-60"
          >
            {saving ? (
              <>
                <Loader2 className="h-5 w-5 animate-spin" />
                Kaydediliyor...
              </>
            ) : (
              'Ayarları Kaydet'
            )}
          </button>
        </footer>
      </div>
    </div>
  )
}

